---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "text";
  external?: boolean;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  external = false,
  ariaLabel,
} = Astro.props;
---

<a
  class:list={["button-link", `button-link--${variant}`]}
  href={href}
  aria-label={ariaLabel}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
>
  <slot />
  <span aria-hidden="true" class="button-link__arrow">↗</span>
</a>

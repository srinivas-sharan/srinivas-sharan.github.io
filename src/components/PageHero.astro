---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  note?: string;
}

const { eyebrow, title, intro, note } = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero__grid">
    <p class="eyebrow"><span></span>{eyebrow}</p>
    <div>
      <h1>{title}</h1>
      <p class="page-hero__intro">{intro}</p>
      {note && <p class="page-hero__note">{note}</p>}
      <slot />
    </div>
  </div>
</section>

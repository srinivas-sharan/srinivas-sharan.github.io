---
import type { Publication } from "../data/content";

interface Props { publication: Publication }
const { publication } = Astro.props;
---

<article class="publication-item">
  <span class="publication-item__year">{publication.year}</span>
  <div>
    <p class="publication-item__meta">{publication.kind ?? publication.venue}</p>
    <h3>{publication.title}</h3>
    {publication.citation && <p>{publication.citation}</p>}
    {publication.kind && <p>{publication.venue}</p>}
  </div>
  {publication.url && <a href={publication.url} target="_blank" rel="noreferrer" aria-label={`Open publication: ${publication.title}`}>View <span aria-hidden="true">↗</span></a>}
</article>

---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import CvButton from "../components/CvButton.astro";
import NewsItem from "../components/NewsItem.astro";
import Recruitment from "../components/Recruitment.astro";
import ResearchFramework from "../components/ResearchFramework.astro";
import MethodologicalThemes from "../components/MethodologicalThemes.astro";
import { identity, metrics, areas, featuredProjects, projectScope, areaScope, recentNews } from "../data/home";
import hero from "../assets/photos/hero-robotics-crop.webp";
import robot from "../assets/photos/20250903_IRES_0014.jpg";
import truck from "../assets/photos/Srinivas.jpg";
import academic from "../assets/photos/SharanSuit.jpg";
import teaching from "../assets/photos/Drones-6-2.jpg";
import collaboration from "../assets/photos/NSF-I-Corps_0005-2048x1152.jpg";
import steel from "../assets/photos/steel-forecast-card.webp";
import anchorage from "../assets/photos/FreightAnalytics_Anchorage.png";
import AreaMethodTags from "../components/AreaMethodTags.astro";
import ResearchScene from "../components/ResearchScene.astro";
import "../styles/home.css";
const projectImages = {
  "project-02": {src: steel, alt: "Steel market analytics platform showing a price forecast and decision-support dashboard."},
  "project-01": {src: anchorage, alt: "Sharan Srinivas and students in Alaska with mountains in the background."},
  "project-03": {src: robot, alt: "Sharan Srinivas operating a robot controller in the Industry 4.0 laboratory"},
  "project-12": {src: truck, alt: "Sharan Srinivas and a collaborator beside a Workhorse Aero delivery vehicle"}
};
const degrees = [
  {year:"2017", degree:"PhD", field:"Industrial Engineering & Operations Research", school:"Penn State"},
  {year:"2015", degree:"MEng", field:"Industrial Engineering & Operations Research", school:"Penn State"},
  {year:"2013", degree:"MS", field:"Industrial & Systems Engineering", school:"Binghamton University"},
  {year:"2011", degree:"BE", field:"Industrial Engineering", school:"College of Engineering, Guindy / Anna University"}
];
---
<BaseLayout title="Sharan Srinivas" description={identity.intro}>
<div class="scholarly-home">
  <section class="personal-hero">
    <div class="container hero-split">
      <div>
        <h1>Sharan Srinivas</h1>
        <p class="personal-hero__role">Associate Professor &amp; Director of Graduate Studies<br /><span>Industrial &amp; Systems Engineering, University of Missouri</span></p>
        <h2 class="personal-hero__proposition">{identity.proposition}</h2>
        <p class="home-hero__lead">{identity.intro}</p>
        <div class="button-row"><ButtonLink href="/research/">Explore Research</ButtonLink><ButtonLink href="/research/group/" variant="secondary">Meet OptiDec</ButtonLink><CvButton /></div>
      </div>
      <figure class="hero-photo"><Image src={hero} alt="Sharan Srinivas in the Industry 4.0 laboratory, with robotic arms and manufacturing equipment" widths={[640,960,1280]} sizes="(max-width: 900px) 90vw, 46vw" width={1280} format="webp" quality={85} loading="eager" fetchpriority="high" /></figure>
    </div>
  </section>
  <section class="section framework-section" aria-labelledby="approach-title">
    <div class="container">
      <h2 id="approach-title">Operations Research + Artificial Intelligence</h2>
      <ResearchFramework />
      <MethodologicalThemes transition />
    </div>
  </section>
  <section class="section" aria-labelledby="areas-title">
    <div class="container">
      <h2 id="areas-title">Research Areas</h2>
      <div class="home-area-grid">
        {areas.map(area => <article class="home-area-card">
          <ResearchScene area={area.id} />
          <h3>{area.title}</h3><p>{areaScope[area.id]}</p>
          <AreaMethodTags tags={area.methodTags} />
          <a class="text-link" href={`/research/areas/#${area.id}`} aria-label={`Explore ${area.title}`}>Explore area <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>
  <section class="section feature-section" aria-labelledby="projects-title">
    <div class="container">
      <div class="home-section-heading"><h2 id="projects-title">Current Research Projects</h2><a class="text-link" href="/research/projects/">View all projects <span aria-hidden="true">↗</span></a></div>
      <div class="home-project-grid">
        {featuredProjects.map(project => <article class="home-project-card">
          {<Image class:list={["project-photo", {"project-photo--robot":project.id === "project-03", "project-photo--anchorage":project.id === "project-01"}]} src={projectImages[project.id as keyof typeof projectImages].src} alt={projectImages[project.id as keyof typeof projectImages].alt} widths={[400,800]} sizes="(max-width: 700px) 90vw, 45vw" width={800} format="webp" quality={90} loading="lazy" />}
          <div class="project-copy"><p class="project-meta">{project.area}</p><h3><a href={`/research/projects/#${project.id}`}>{project.title}</a></h3><p>{projectScope[project.id]}</p><p class="project-meta">{project.sponsor}<br />{project.period} · {project.role}</p></div>
        </article>)}
      </div>
    </div>
  </section>
  <section class="section home-impact" aria-labelledby="impact-title">
    <div class="container">
      <h2 id="impact-title">Research Impact</h2>
      <dl class="impact-grid">{metrics.map(metric => <div class:list={["impact-metric", { "impact-metric--mentoring": metric.id === "mentoring" }]}><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>
    </div>
  </section>
  <section class="section community-section">
    <div class="container">
      <div class="group-preview">
        <div><p class="eyebrow">OPTIDEC</p><h2>{identity.groupName}</h2><p>Graduate and undergraduate researchers work across optimization, AI, analytics, simulation, and complex operational systems, through sponsored research and research training.</p><a class="text-link" href="/research/group/">Meet OptiDec <span aria-hidden="true">↗</span></a></div>
        <a class="group-photo-note" href="https://engineering.missouri.edu/2026/optimizing-warehouse-execution-through-human-robot-collaboration/"><Image src={collaboration} alt="Sharan Srinivas and PhD candidate Arghadeep Mitra" width={600} format="webp" loading="lazy" /><div><p>NSF I-Corps · 2026</p><strong>Translating Human-Robot Research</strong><p>Cobot iCommander applies optimization and AI-enabled decision support to coordinate humans, autonomous mobile robots (AMRs), and warehouse tasks in real time.</p></div></a>
      </div>
      <Recruitment compact />
      <div class="academic-profile" id="profile">
        <div class="profile-intro"><Image src={academic} alt="Formal portrait of Sharan Srinivas in a suit" width={600} format="webp" loading="lazy" /><div><h2>Academic Profile</h2><ul class="academic-roles"><li>Associate Professor, Industrial &amp; Systems Engineering</li><li>Director of Graduate Studies</li><li>Affiliate Faculty, Quantum Innovation Center</li><li>Core Faculty, Institute for Data Science and Informatics</li></ul></div></div>
        <div><h3 class="education-heading">Education</h3><ol class="degree-journey">{degrees.map(item => <li><span class="degree-year">{item.year}</span><div><strong>{item.degree} <span>· {item.school}</span></strong><p>{item.field}</p></div></li>)}</ol></div>
      </div>
    </div>
  </section>
  <section class="section feature-section">
    <div class="container home-pathways">
      <article><h2>Teaching &amp; Education</h2><div class="teaching-preview"><Image src={teaching} alt="A student operating a drone with Sharan Srinivas in a teaching laboratory" width={500} format="webp" loading="lazy" /><p>Courses and research training connect optimization, analytics, simulation, AI, and emerging technologies with hands-on operational problems.</p></div><a class="text-link" href="/teaching-education/">Courses &amp; research training <span aria-hidden="true">↗</span></a></article>
      <article><h2>Leadership &amp; Service</h2><dl class="home-service-summary"><div><dt>Conference Leadership</dt><dd>Program Chair · 2027 IISE Annual Conference</dd></div><div><dt>Professional Leadership</dt><dd>Former President · IISE Operations Research Division</dd></div><div><dt>Editorial Service</dt><dd>Transportation Research Part E · Scientific Reports</dd></div></dl><a class="text-link" href="/leadership-service/">Selected roles &amp; service <span aria-hidden="true">↗</span></a></article>
    </div>
  </section>
  <section class="section news-preview">
    <div class="container">
      <div class="home-section-heading"><h2>Selected Recognition</h2><a class="text-link" href="/news/">News archive <span aria-hidden="true">↗</span></a></div>
      <div class="news-list">{recentNews.map(item => <NewsItem item={item} />)}</div>
    </div>
  </section>
</div>
</BaseLayout>

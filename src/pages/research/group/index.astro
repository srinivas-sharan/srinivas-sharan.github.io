---
import {Image} from 'astro:assets';
import ResearchLayout from '../../../layouts/ResearchLayout.astro';
import TechnicalCapabilities from '../../../components/TechnicalCapabilities.astro';
import Recruitment from '../../../components/Recruitment.astro';
import ResearcherCard from '../../../components/ResearcherCard.astro';
import ResearchEcosystem from '../../../components/ResearchEcosystem.astro';
import community from '../../../assets/photos/optidec-community-2024.jpg';
import photo from '../../../assets/photos/GradLab_Students.jpg';
import award from '../../../assets/photos/RayPyamAward.jpg';
import {labName,currentResearchers,phdAlumni,msAlumni,training,recognition,undergraduateResearchers,alumniPositions} from '../../../data/research';
const initials=(name:string)=>name.split(' ').map(n=>n[0]).filter((_,i,arr)=>i===0||i===arr.length-1).join('');
---
<ResearchLayout title="Research Group" description="Meet OptiDec, the Optimization & Intelligent Decision Systems Lab led by Sharan Srinivas at the University of Missouri.">
<header class="container research-hero group-hero"><h1>Research Group</h1><span class="research-kicker">OptiDec</span><h2>{labName}</h2><p>OptiDec is the Optimization &amp; Intelligent Decision Systems Lab led by Sharan Srinivas in Industrial &amp; Systems Engineering at the University of Missouri. The group develops and applies operations research, analytics, simulation, and AI methods to complex operational systems.</p><p class="faculty-lead">Faculty Lead: Sharan Srinivas</p><figure><Image src={photo} alt="OptiDec researchers with project posters in the Industrial & Systems Engineering research space." widths={[640,1000,1440]} sizes="90vw" width={1440} quality={90} format="webp" loading="eager"/><figcaption>OptiDec researchers and project teams.</figcaption></figure></header>
<TechnicalCapabilities />
<Recruitment />
<section class="section research-neutral"><div class="container" data-researcher-filter><h2>Current Researchers</h2><div class="filter-buttons researcher-filters" role="group" aria-label="Filter current researchers by degree" data-filter-controls hidden>{['All','PhD','MS','Undergraduate'].map((degree,i)=><button type="button" data-degree-filter={degree} aria-pressed={i===0?'true':'false'}>{degree}</button>)}</div><p class="filter-result" data-filter-result role="status" aria-live="polite">{currentResearchers.length} graduate researchers · {undergraduateResearchers.length} undergraduate researchers listed below</p>
 <div class="researcher-grid">{currentResearchers.map(p=><ResearcherCard person={p}/>)}</div>
 <a class="text-link" href="#undergraduate-researchers">See undergraduate researchers ↓</a>
</div></section>
<section class="section"><div class="container"><h2>Research at OptiDec</h2><p>Research combines methodological development, real operational problems, sponsored projects, and scholarly or translational outputs. Researchers may contribute across several of these dimensions simultaneously.</p><ResearchEcosystem /></div></section>
<section class="section research-neutral"><div class="container"><h2>Research Training</h2><div class="training-experiences">{training.map(t=><article><span class="research-kicker">{t.name}</span><h3>{t.title}</h3><p>{t.description}</p>{t.url&&<a class="text-link" href={t.url}>Program story ↗</a>}</article>)}</div></div></section>
<section class="section"><div class="container"><h2>Student Research &amp; Recognition</h2><div class="student-recognition-layout"><figure><Image src={award} alt="Student researchers and Sharan Srinivas with research-poster and IISE recognition certificates at a 2024 research event" width={800} quality={90} format="webp" loading="lazy"/><figcaption>Student research recognition · 2024</figcaption></figure><div class="research-recognition">{recognition.map(r=><article><span>{r.year}</span><div><h3>{r.title}</h3><p>{r.description}</p>{r.url&&<a class="text-link" href={r.url}>Read the story ↗</a>}</div></article>)}</div></div></div></section>
<section class="section"><div class="container research-community-photo"><h2>Research Community</h2><p>OptiDec brings together graduate and undergraduate researchers through project teams, research training, conferences, mentoring, and informal group activities.</p><Image src={community} alt="Members of the Industrial & Systems Engineering research community at a group gathering." widths={[640,1000,1440]} sizes="90vw" width={1440} quality={85} format="webp" loading="lazy"/></div></section>
<section class="section research-neutral"><div class="container"><h2>Alumni</h2><h3>PhD Alumni</h3><div class="phd-alumni">{phdAlumni.map(p=><article id={p.id}><h4>{p.name}</h4><span>PhD · {p.completions.find(c=>c.degree==='PhD')?.period}</span>{alumniPositions[p.id]?.map(line=><p>{line}</p>)}</article>)}</div><details class="ms-alumni"><summary aria-expanded="false">View MS alumni</summary><div class="alumni-directory">{msAlumni.map(p=><div id={p.id}><strong>{p.name}</strong><span>MS · {p.completions.find(c=>c.degree==='MS')?.period}</span>{alumniPositions[p.id]?.map(line=><span>{line}</span>)}</div>)}</div></details></div></section>
<section class="section" id="undergraduate-researchers"><div class="container"><h2>Undergraduate Researchers</h2><p class="research-note">Spring 2026</p><div class="researcher-grid">{undergraduateResearchers.map(p=><article class="researcher-card undergraduate-tile" data-researcher data-degrees="Undergraduate"><div class="researcher-identity"><span class="researcher-avatar" aria-hidden="true">{initials(p.name)}</span><div><h3>{p.name}</h3><p>{p.role}</p></div></div></article>)}</div><p class="research-note">50+ undergraduate students mentored across university and NSF-supported research experiences.</p></div></section>
</ResearchLayout>

---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeachingMark from "../../components/TeachingMark.astro";
import photo from "../../assets/photos/Drones-6-2.jpg";
import { courses, additional, breadth, stages, programs, regions, recognition } from "../../data/teaching";
import "../../styles/teaching.css";
---
<BaseLayout title="Teaching & Education" description="Courses, learning approaches, research training, and global engineering education.">
<div class="teaching-page">
<header class="container teaching-hero">
  <div><h1>Teaching &amp; Education</h1><p>My teaching emphasizes problem-centered and research-connected learning. Students work with realistic operational problems, analytical models, and hands-on tools to move from data and methods to well-supported engineering and managerial decisions.</p></div>
  <Image src={photo} alt="A student operating a drone with Sharan Srinivas in a teaching laboratory" width={900} format="webp" quality={90} loading="eager" />
</header>
<section class="section"><div class="container">
<h2>How I Teach</h2>
<ol class="learning-path reveal">{stages.map(([title,description],i)=><li style={`--stage:${i}`}><span class="path-node">{String(i+1).padStart(2,'0')}</span><TeachingMark kind={['problem','tools','research','collaboration'][i]} /><h3>{title}</h3><p>{description}</p></li>)}</ol>
<div class="path-end">
  <span class="path-end__arrow" aria-hidden="true">↓</span>
  <div><h3>From methods to informed decisions</h3><p>Real problems, hands-on analysis, research, and collaboration come together in well-supported engineering and managerial decisions.</p></div>
</div>
<div class="practice"><h2>Teaching in Practice</h2><ol class="process-flow">{['Operational Problem','Formulate / Model','Analyze / Implement','Interpret','Decide'].map(t=><li>{t}</li>)}</ol><p>Course activities combine structured problem solving, software implementation, case-based analysis, and interpretation of results in operational context.</p></div>
</div></section>
<section class="section"><div class="container">
<h2>Teaching Across Methods &amp; Systems</h2>
<p>Explore how analytical methods and engineering systems connect across the course portfolio.</p>
<div class="method-selectors" role="group" aria-label="Teaching areas"><button data-breadth="all" aria-pressed="true">All</button>{breadth.map(group=><button data-breadth={group.id} aria-pressed="false">{group.title}</button>)}</div>
<div class="breadth-strip">{breadth.map(group=><div><h3>{group.title}</h3><div class="method-links">{group.methods.map(method=><button data-method={method} aria-pressed="false">{method}</button>)}</div></div>)}</div>
</div></section>
<section class="section teaching-neutral"><div class="container">
<h2>Selected Courses</h2>
<div class="featured-courses">{courses.map(course=><article class="teaching-course" data-course-id={course.id}>
  <div class="course-meta"><span>{course.code}</span><span>{course.term}</span></div><TeachingMark kind={course.id} />
  <h3>{course.title}</h3><p>{course.description}</p><ul class="teaching-tags">{course.tags.map(tag=><li data-method-tag={tag}>{tag}</li>)}</ul>
  <div class="course-details"><button class="course-toggle" aria-expanded="false" aria-controls={`course-detail-${course.id}`} hidden>Explore course <span aria-hidden="true">+</span></button><div class="course-detail-grid" id={`course-detail-${course.id}`}>
  {[['Methods',course.methods],['Tools',course.tools],['Applications',course.applications]].map(([label,items])=><div><h4>{label}</h4><ul>{(items as string[]).map(t=><li>{t}</li>)}</ul></div>)}
  </div></div>
</article>)}</div>
</div></section>
<section class="section teaching-additional"><div class="container"><h2>Additional Courses &amp; Cross-College Teaching</h2>
<div class="additional-courses">{additional.map(course=><article class="teaching-course" data-course-id={course.id}><h3>{course.title}</h3><p>{course.description}</p></article>)}</div>
</div></section>
<section class="section teaching-neutral"><div class="container"><h2>Educational Innovation &amp; Curriculum Development</h2>
<div class="structured-columns">
<article><h3>Curriculum Development</h3><p>Led the design and submission of undergraduate and graduate Decision and Operations Analytics certificate programs integrating analytics, optimization, and decision modeling across the industrial engineering curriculum.</p></article>
<article><h3>AI &amp; Digital Learning</h3><p>Uses course-specific digital and AI-supported learning tools to reinforce analytical concepts, programming workflows, and structured problem solving.</p></article>
<article><h3>Cloud &amp; CyberTraining</h3><p>Contributed to NSF-supported Cloud DevOps training tailored to industrial engineering workflows and application-inspired analytical systems.</p></article>
</div></div></section>
<section class="section"><div class="container"><h2>Research-Connected Learning</h2>
<ol class="process-flow outcomes-flow"><li>Course Projects</li><li>Research &amp; Technical Development</li><li>Publications · Competitions · Graduate Research</li></ol>
<p>Course projects often extend beyond routine assignments to open-ended operational problems, research literature, and technical communication. Selected projects have developed into competition entries, conference presentations, graduate research, and peer-reviewed publications.</p>
<div class="structured-columns compact-outcomes"><article><h3>Course Projects → Research</h3><p>Applied coursework can develop into deeper technical investigations.</p></article><article><h3>Sponsored Problems → Applied Learning</h3><p>Students engage with real operational contexts and stakeholder-driven problems.</p></article><article><h3>Competitions &amp; Communication</h3><p>Technical work is strengthened through reports, presentations, competitions, and peer review.</p></article></div>
</div></section>
<section class="section teaching-neutral"><div class="container"><h2>Research &amp; Global Education</h2><h3 class="subsection-title">Research Education Ecosystem</h3>
<div class="education-ecosystem reveal">
<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M50 50L20 20M50 50L80 20M50 50L20 80M50 50L80 80" /></svg>
<div class="education-hub"><TeachingMark kind="mentoring" />Research Education</div>
{programs.map(([name,title,description,url],i)=><article class={`program program-${i}`} style={`--stage:${i}`}><h4>{name}</h4><strong>{title}</strong><p>{description}</p><a class="text-link" href={url}>{name} ↗</a></article>)}
</div>
<h3 class="subsection-title global-title">Global Engineering Education</h3>
<div class="global-education reveal">
<div class="academic-map">
<svg viewBox="0 0 800 360" fill="none" aria-hidden="true">
<g class="land"><path d="M45 80L78 62L117 57L142 40L164 55L180 40L213 57L234 52L266 74L253 94L275 105L253 126L233 136L218 158L198 161L190 179L175 169L161 164L159 184L182 207L205 219L214 237L201 234L182 220L165 214L146 194L131 174L120 149L99 133L85 105L59 105Z"/><path d="M242 244L266 231L288 250L311 263L310 283L296 302L282 331L268 351L255 331L255 306L242 283L232 267ZM294 48L326 32L351 49L337 82L313 96L302 72Z"/><path d="M395 114L403 100L421 94L430 76L446 55L452 71L442 95L460 100L476 84L493 83L517 60L552 54L578 64L604 50L644 57L668 74L706 73L747 97L720 113L737 132L719 150L690 158L674 177L650 168L638 190L623 192L627 213L612 217L602 197L589 193L580 228L565 215L550 181L525 174L514 157L492 151L476 135L461 143L447 126L422 128L409 139L393 132Z"/><path d="M410 148L438 145L465 160L481 182L501 192L484 217L478 243L464 272L449 284L433 263L426 238L408 223L399 198L388 181L394 159ZM493 258L502 244L507 259L500 280Z"/><path d="M647 283L669 266L690 276L711 268L730 291L724 313L702 325L685 317L659 321L643 307Z"/></g>
<g class="map-routes"><path pathLength="1" d="M170 130Q295 15 440 110"/><path pathLength="1" d="M170 130Q385 -20 580 215"/></g>
<g class="map-dots"><circle cx="170" cy="130" r="6"/><circle cx="440" cy="110" r="6"/><circle cx="580" cy="215" r="6"/></g>
<g class="map-labels"><text x="130" y="158">Missouri</text><text x="420" y="95">Germany</text><text x="596" y="224">India</text></g>
</svg>
<div class="region-selectors" role="group" aria-label="Explore global education connections">{regions.map((region,i)=><button data-region={region.id} aria-pressed={i===0?'true':'false'} aria-controls={`region-${region.id}`}><TeachingMark kind={i===0?'home':'university'} /><span>{region.title}</span><small>{i===0?'Home base':'Academic partners'}</small></button>)}</div>
</div>
<div class="region-panels" aria-live="polite" aria-atomic="true">{regions.map((region,i)=><article id={`region-${region.id}`} data-region-panel={region.id} hidden={i!==0}><h4>{region.title}</h4><ul class="institutions">{region.institutions.map(name=><li>{name}</li>)}</ul><ul class="teaching-tags">{region.tags.map(tag=><li>{tag}</li>)}</ul><p>{region.description}</p></article>)}</div>
</div>
</div></section>
<section class="section"><div class="container"><h2>Teaching Recognition</h2><ol class="recognition-timeline reveal">{recognition.map(([year,title,institution,url],i)=><li style={`--stage:${i}`}><span>{year}</span><h3>{title}</h3><p>{institution}</p>{url&&<a class="text-link" href={url}>Recognition ↗</a>}</li>)}</ol></div></section>
</div>
</BaseLayout>
<script define:vars={{portfolio:[...courses,...additional],breadth}}>window.teachingPortfolio = {portfolio,breadth};</script>
<script src="../../scripts/teaching.ts"></script>
